<Page x:Class="RathoreSearchAutomation.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Page.Resources>
        <!-- Font Families -->
        <FontFamily x:Key="SFProRounded">pack://application:,,,/Resources/Fonts/#SF Pro Rounded</FontFamily>
        <FontFamily x:Key="Roboto">pack://application:,,,/Resources/Fonts/#Roboto</FontFamily>
    </Page.Resources>

    <Grid>
        <!-- Glass Card Container -->
        <Border x:Name="GlassCard"
                MaxWidth="480"
                Padding="50"
                CornerRadius="25">
            
            <!-- Real Glassmorphism Effect -->
            <Border.Background>
                <SolidColorBrush Color="White" Opacity="0.15"/>
            </Border.Background>
            
            <Border.BorderBrush>
                <SolidColorBrush Color="White" Opacity="0.3"/>
            </Border.BorderBrush>
            
            <Border.BorderThickness>1</Border.BorderThickness>
            
            <!-- Shadow Effect -->
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="20" 
                                BlurRadius="60" Opacity="5"/>
            </Border.Effect>
            
            <StackPanel>
                <!-- RATHORE Title -->
                <TextBlock x:Name="TitleText"
                          Text="RATHORE"
                          FontFamily="{StaticResource SFProRounded}"
                          FontSize="36"
                          FontWeight="Bold"
                          Foreground="Black"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,25">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="White" Direction="0" ShadowDepth="0" 
                                        BlurRadius="10" Opacity="0.8"/>
                    </TextBlock.Effect>
                </TextBlock>
                
                <!-- Welcome Text -->
                <TextBlock x:Name="WelcomeText"
                          Text="Welcome"
                          FontFamily="{StaticResource SFProRounded}"
                          FontSize="26"
                          FontWeight="SemiBold"
                          Foreground="#E6000000"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,8">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="White" Direction="0" ShadowDepth="0" 
                                        BlurRadius="8" Opacity="0.6"/>
                    </TextBlock.Effect>
                </TextBlock>
                
                <TextBlock x:Name="SubtitleText"
                          Text="Sign in to your account"
                          FontFamily="{StaticResource Roboto}"
                          FontSize="15"
                          Foreground="#B3000000"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,35">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="White" Direction="0" ShadowDepth="0" 
                                        BlurRadius="6" Opacity="0.5"/>
                    </TextBlock.Effect>
                </TextBlock>
                
                <!-- User ID Field -->
                <TextBlock x:Name="UserIdLabel"
                          Text="User ID"
                          FontFamily="{StaticResource Roboto}"
                          FontSize="14"
                          FontWeight="Medium"
                          Foreground="#E6000000"
                          Margin="0,0,0,10">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="White" Direction="0" ShadowDepth="0" 
                                        BlurRadius="6" Opacity="0.5"/>
                    </TextBlock.Effect>
                </TextBlock>
                
                <TextBox x:Name="UserIdTextBox"
                        Style="{StaticResource GlassTextBox}"
                        FontFamily="{StaticResource Roboto}"
                        Margin="0,0,0,22"
                        Text=""/>
                
                <!-- Key Field -->
                <TextBlock x:Name="KeyLabel"
                          Text="Key"
                          FontFamily="{StaticResource Roboto}"
                          FontSize="14"
                          FontWeight="Medium"
                          Foreground="#E6000000"
                          Margin="0,0,0,10">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="White" Direction="0" ShadowDepth="0" 
                                        BlurRadius="6" Opacity="0.5"/>
                    </TextBlock.Effect>
                </TextBlock>
                
                <PasswordBox x:Name="KeyPasswordBox"
                            Style="{StaticResource GlassPasswordBox}"
                            FontFamily="{StaticResource Roboto}"
                            Margin="0,0,0,30"/>
                
                <!-- Sign In Button -->
                <Button x:Name="SignInButton"
                       Content="Sign In"
                       Style="{StaticResource GlassButton}"
                       FontFamily="{StaticResource SFProRounded}"
                       Height="48"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Click="SignInButton_Click"
                       Margin="0,0,0,28"/>
                
                <!-- Telegram Button -->
                <Button x:Name="TelegramButton"
                       Click="TelegramButton_Click"
                       Style="{StaticResource GlassButton}"
                       HorizontalAlignment="Center"
                       Padding="18,12" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <!-- Telegram Logo -->
                        <Image Source="/Resources/icons/telegram.png"
                              Width="20" 
                              Height="20" 
                              Margin="0,0,10,0" Cursor="Hand"/>
                        <TextBlock Text="Telegram" 
                                  Foreground="Black"
                                  FontFamily="{StaticResource Roboto}"
                                  FontSize="14"
                                  FontWeight="Medium"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>
