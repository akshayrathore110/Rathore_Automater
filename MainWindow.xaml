<Window x:Class="RathoreSearchAutomation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:RathoreSearchAutomation.Pages"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    Title="RATHORE Search Automation" 
    Height="700" 
    Width="1000"
    MinHeight="560"
    MinWidth="900"
    Icon="pack://application:,,,/Resources/icons/App_logo.png"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="CanResize">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                             ResizeBorderThickness="6"
                             GlassFrameThickness="0"
                             UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    
    <Window.Resources>
        <!-- Font Families -->
        <FontFamily x:Key="SFProRounded">pack://application:,,,/Resources/Fonts/#SF Pro Rounded</FontFamily>
        <FontFamily x:Key="Roboto">pack://application:,,,/Resources/Fonts/#Roboto</FontFamily>

        <!-- Theme Icon Tunables: adjust these to move/resize the sun/moon icon -->
        <sys:Double x:Key="ThemeIconSize">18</sys:Double>
        <Thickness x:Key="ThemeIconMargin">0</Thickness>
        <HorizontalAlignment x:Key="ThemeIconHAlign">Center</HorizontalAlignment>
        <VerticalAlignment x:Key="ThemeIconVAlign">Center</VerticalAlignment>

        <!-- Glassmorphism Plate Tunables for the Theme Toggle group -->
        <Thickness x:Key="ThemePlatePadding">8,4</Thickness>
        <CornerRadius x:Key="ThemePlateCornerRadius">10</CornerRadius>
        <Thickness x:Key="ThemePlateBorderThickness">1</Thickness>
        <SolidColorBrush x:Key="ThemePlateBackground" Color="#1AFFFFFF"/>
        <SolidColorBrush x:Key="ThemePlateBorderBrush" Color="#40FFFFFF"/>
        <Thickness x:Key="ThemePlateMargin">0,4,6,4</Thickness>
    </Window.Resources>
    
    <!-- Removed WindowChrome because shell namespace caused compile errors in your environment. -->
    
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Background Image -->
        <Grid.Background>
            <ImageBrush x:Name="BackgroundBrush" 
                       ImageSource="pack://application:,,,/Resources/light-bg.jpg" 
                       Stretch="UniformToFill"/>
        </Grid.Background>
        
        <!-- Window Border -->
        <Border BorderBrush="#33FFFFFF" 
                BorderThickness="1"
                CornerRadius="0"/>
        
        <!-- Title Bar -->
      <Grid Grid.Row="0" Height="40" 
              VerticalAlignment="Top"
          Background="Transparent"
          MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- App Title -->
            <TextBlock Text="RATHORE Search Automation"
                      x:Name="TitleBarText"
                      Grid.Column="0"
                      VerticalAlignment="Center"
                      Margin="15,0,0,0"
                      FontFamily="{StaticResource SFProRounded}"
                      FontSize="13"
                      FontWeight="Medium"
                      Foreground="#E6000000">
                <TextBlock.Effect>
                    <DropShadowEffect Color="White" Direction="0" ShadowDepth="0" 
                                    BlurRadius="6" Opacity="0.6"/>
                </TextBlock.Effect>
            </TextBlock>

            <!-- Window Controls -->
            <StackPanel Grid.Column="1" 
                       Orientation="Horizontal"
                       HorizontalAlignment="Right">

                <!-- Glassmorphism plate for Theme Toggle -->
                <Border Margin="{DynamicResource ThemePlateMargin}"
                        Padding="{DynamicResource ThemePlatePadding}"
                        Background="{DynamicResource ThemePlateBackground}"
                        BorderBrush="{DynamicResource ThemePlateBorderBrush}"
                        BorderThickness="{DynamicResource ThemePlateBorderThickness}"
                        CornerRadius="{DynamicResource ThemePlateCornerRadius}">
                    <Border.Effect>
                        <DropShadowEffect Color="#55000000" BlurRadius="8" ShadowDepth="0" Opacity="0.35"/>
                    </Border.Effect>
                    <!-- Theme Toggle Button -->
                    <Button x:Name="ThemeToggleButton"
                            Width="46" Height="32"
                            Click="ThemeToggleButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                       CornerRadius="6"
                                       Padding="8,4">
                                    <Grid>
                                        <!-- Sun Icon (Light Mode) PNG -->
                                        <Image x:Name="SunIcon"
                                               Width="{DynamicResource ThemeIconSize}"
                                               Height="{DynamicResource ThemeIconSize}"
                                               Margin="{DynamicResource ThemeIconMargin}"
                                               HorizontalAlignment="{DynamicResource ThemeIconHAlign}"
                                               VerticalAlignment="{DynamicResource ThemeIconVAlign}"
                                               Stretch="Uniform"
                                               Source="pack://application:,,,/Resources/icons/sun.png"/>

                                        <!-- Moon Icon (Dark Mode) PNG -->
                                        <Image x:Name="MoonIcon"
                                               Width="{DynamicResource ThemeIconSize}"
                                               Height="{DynamicResource ThemeIconSize}"
                                               Margin="{DynamicResource ThemeIconMargin}"
                                               HorizontalAlignment="{DynamicResource ThemeIconHAlign}"
                                               VerticalAlignment="{DynamicResource ThemeIconVAlign}"
                                               Stretch="Uniform"
                                               Visibility="Collapsed"
                                               Source="pack://application:,,,/Resources/icons/moon.png"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <SolidColorBrush Color="White" Opacity="0.15"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Border>

                <!-- Minimize Button -->
                <Button x:Name="MinimizeButton"
                       Width="46" Height="32"
                       Click="MinimizeButton_Click"
                       Margin="0,4,4,4"
                       Background="Transparent"
                       BorderThickness="0"
                       Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                   CornerRadius="6"
                                   Padding="8,4">
                                <TextBlock Text="─" 
                                          FontSize="16" 
                                          x:Name="MinimizeText"
                                          Foreground="#E6000000"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="0,-4,0,0">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="White" Direction="0" ShadowDepth="0" 
                                                        BlurRadius="4" Opacity="0.8"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <SolidColorBrush Color="White" Opacity="0.15"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
          </Button>

          <!-- Maximize/Restore Button -->
          <Button x:Name="MaximizeButton"
                       Width="46" Height="32"
                       Click="MaximizeButton_Click"
                       Margin="0,4,4,4"
                       Background="Transparent"
                       BorderThickness="0"
                       Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                   CornerRadius="6"
                                   Padding="8,4">
                                <TextBlock Text="□" 
                                          FontSize="16" 
                                          x:Name="MaximizeText"
                                          Foreground="#E6000000"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="White" Direction="0" ShadowDepth="0" 
                                                        BlurRadius="4" Opacity="0.8"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <SolidColorBrush Color="White" Opacity="0.15"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
          </Button>

          <!-- Close Button -->
          <Button x:Name="CloseButton"
                       Width="46" Height="32"
                       Click="CloseButton_Click"
                       Margin="0,4,8,4"
                       Background="Transparent"
                       BorderThickness="0"
                       Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                   CornerRadius="6"
                                   Padding="8,4">
                                <TextBlock Text="✕" 
                                          FontSize="16" 
                                          x:Name="CloseText"
                                          Foreground="#E6000000"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="White" Direction="0" ShadowDepth="0" 
                                                        BlurRadius="4" Opacity="0.8"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E81123"/>
                                    <Setter Property="Opacity" Value="0.9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
        
        <!-- Page Container -->
     <Frame Grid.Row="1" x:Name="MainFrame" 
               NavigationUIVisibility="Hidden"
               Background="Transparent"
         />
        
        <!-- Running Page Overlay Container -->
      <Grid Grid.Row="1" x:Name="RunningOverlay" 
              Visibility="Collapsed"
              Background="#80000000">
            <Frame x:Name="OverlayFrame" 
                   NavigationUIVisibility="Hidden"
                   Background="Transparent"/>
        </Grid>
    </Grid>
</Window>
