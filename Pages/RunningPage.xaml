<Page x:Class="RathoreSearchAutomation.Pages.RunningPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Page.Resources>
        <!-- Font Families -->
        <FontFamily x:Key="SFProRounded">pack://application:,,,/Resources/Fonts/#SF Pro Rounded</FontFamily>
        <FontFamily x:Key="Roboto">pack://application:,,,/Resources/Fonts/#Roboto</FontFamily>
    </Page.Resources>

    <Grid>
        <!-- Glass Card Container -->
        <Border MaxWidth="500"
                Padding="50"
                CornerRadius="25">
            
            <Border.Background>
                <SolidColorBrush Color="White" Opacity="0.15"/>
            </Border.Background>
            
            <Border.BorderBrush>
                <SolidColorBrush Color="White" Opacity="0.3"/>
            </Border.BorderBrush>
            
            <Border.BorderThickness>1</Border.BorderThickness>
            
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="20" 
                                BlurRadius="60" Opacity="0.5"/>
            </Border.Effect>
            
            <StackPanel>
                <!-- RATHORE Title -->
                <TextBlock x:Name="TitleText"
                          Text="RATHORE"
                          FontFamily="{StaticResource SFProRounded}"
                          FontSize="32"
                          FontWeight="Bold"
                          Foreground="White"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,20"/>
                
                <!-- Search Automation Text -->
                <TextBlock x:Name="HeaderText"
                          Text="Search Automation"
                          FontFamily="{StaticResource SFProRounded}"
                          FontSize="24"
                          FontWeight="SemiBold"
                          Foreground="White"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,5"/>
                
                <TextBlock x:Name="StatusHeaderText"
                          Text="Running..."
                          FontFamily="{StaticResource Roboto}"
                          FontSize="14"
                          Foreground="#B3FFFFFF"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,30"/>
                
                <!-- Progress Section -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Text="Progress"
                              FontFamily="{StaticResource Roboto}"
                              FontSize="14"
                              FontWeight="Medium"
                              Foreground="#E6FFFFFF"
                              Grid.Column="0"/>
                    
                    <TextBlock x:Name="ProgressText"
                              Text="0 / 20"
                              FontFamily="{StaticResource Roboto}"
                              FontSize="14"
                              Foreground="#E6FFFFFF"
                              Grid.Column="1"/>
                </Grid>
                
                <!-- Progress Bar -->
                <ProgressBar x:Name="ProgressBar"
                            Style="{StaticResource GlassProgressBar}"
                            Value="0"
                            Maximum="100"
                            Margin="0,0,0,20"/>
                
                <!-- Current Status Box -->
                <Border Background="#1AFFFFFF"
                       CornerRadius="10"
                       Padding="15"
                       Margin="0,0,0,25">
                    <TextBlock x:Name="StatusText"
                              Text="Initializing..."
                              FontFamily="{StaticResource Roboto}"
                              FontSize="13"
                              Foreground="#CCFFFFFF"
                              TextWrapping="Wrap"/>
                </Border>
                
                <!-- Control Buttons -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Pause/Resume Button -->
                    <Button x:Name="PauseResumeButton"
                           Click="PauseResumeButton_Click"
                           Style="{StaticResource GlassButton}"
                           FontFamily="{StaticResource SFProRounded}"
                           FontWeight="SemiBold"
                           Height="45"
                           Grid.Column="0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Rectangle x:Name="PauseIcon"
                                     Width="16" Height="16"
                                     Fill="White"
                                     Margin="0,0,8,0"/>
                            <Polygon x:Name="PlayIcon"
                                   Points="0,0 16,8 0,16"
                                   Fill="White"
                                   Margin="0,0,8,0"
                                   Visibility="Collapsed"/>
                            <TextBlock x:Name="PauseResumeText"
                                      Text="Pause" 
                                      Foreground="White"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <!-- Stop Button -->
                    <Button x:Name="StopButton"
                           Click="StopButton_Click"
                           FontFamily="{StaticResource SFProRounded}"
                           FontWeight="SemiBold"
                           Height="45"
                           Grid.Column="2">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GlassButton}">
                                <Setter Property="Background" Value="#4DFF0000"/>
                                <Setter Property="BorderBrush" Value="#80FF6666"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#66FF0000"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Rectangle Fill="White"
                                      Width="16"
                                      Height="16"
                                      Margin="0,0,8,0"/>
                            <TextBlock Text="Stop" 
                                      Foreground="White"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Page>
