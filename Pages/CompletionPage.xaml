<Page x:Class="RathoreSearchAutomation.Pages.CompletionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">

    <Page.Resources>
        <!-- Font Families -->
        <FontFamily x:Key="SFProRounded">pack://application:,,,/Resources/Fonts/#SF Pro Rounded</FontFamily>
        <FontFamily x:Key="Roboto">pack://application:,,,/Resources/Fonts/#Roboto</FontFamily>
    </Page.Resources>

    <Grid>
        <!-- Glass Card Container -->
        <Border MaxWidth="480"
                Padding="50"
                CornerRadius="25">
            
            <Border.Background>
                <SolidColorBrush Color="White" Opacity="0.15"/>
            </Border.Background>
            
            <Border.BorderBrush>
                <SolidColorBrush Color="White" Opacity="0.3"/>
            </Border.BorderBrush>
            
            <Border.BorderThickness>1</Border.BorderThickness>
            
            <Border.Effect>
                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="20" 
                                BlurRadius="60" Opacity="0.5"/>
            </Border.Effect>
            
            <StackPanel>
                <!-- RATHORE Title -->
                <TextBlock x:Name="TitleText"
                          Text="RATHORE"
                          FontFamily="{StaticResource SFProRounded}"
                          FontSize="32"
                          FontWeight="Bold"
                          Foreground="White"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,20"/>
                
                <!-- Success Icon -->
                <Border Background="#33008000"
                       Width="80"
                       Height="80"
                       CornerRadius="40"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20">
                    <Ellipse Width="40" Height="40" Stroke="#66FF66" StrokeThickness="3" Fill="Transparent"/>
                </Border>
                
                <!-- Completion Text -->
                <TextBlock Text="Search Completed!"
                          FontFamily="{StaticResource SFProRounded}"
                          FontSize="24"
                          FontWeight="SemiBold"
                          Foreground="White"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,5"/>
                
                <TextBlock x:Name="CompletionDetails"
                          Text="Successfully completed 20 searches"
                          FontFamily="{StaticResource Roboto}"
                          FontSize="14"
                          Foreground="#B3FFFFFF"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,30"/>
                
                <!-- Restart Button -->
                <Button x:Name="RestartButton"
                       Click="RestartButton_Click"
                       Style="{StaticResource GlassButton}"
                       FontFamily="{StaticResource SFProRounded}"
                       Height="45"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="0,0,0,15">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse Width="20" Height="20" Stroke="White" StrokeThickness="2" Fill="Transparent" Margin="0,0,8,0"/>
                        <TextBlock Text="Restart Program" 
                                  Foreground="White"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                
                <!-- Exit Button -->
                <Button x:Name="ExitButton"
                       Click="ExitButton_Click"
                       FontFamily="{StaticResource SFProRounded}"
                       Height="45"
                       FontSize="16"
                       FontWeight="SemiBold">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GlassButton}">
                            <Setter Property="Background" Value="#4DFF0000"/>
                            <Setter Property="BorderBrush" Value="#80FF6666"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#66FF0000"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Rectangle Width="20" Height="20" Fill="White" Margin="0,0,8,0"/>
                        <TextBlock Text="Exit Program" 
                                  Foreground="White"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>
